      "source": [
        "data = df.rename(columns={                  # Give every column a short, easy name\n",
        "    \"battery_power\": \"Battery\",      # Battery capacity (mAh)\n",
        "    \"blue\":          \"Bluetooth\",    # Has Bluetooth? (0 = no, 1 = yes)\n",
        "    \"clock_speed\":   \"ClockSpeed\",   # Processor speed (GHz)\n",
        "    \"dual_sim\":      \"DualSim\",      # Has 2 SIM slots? (0 = no, 1 = yes)\n",
        "    \"fc\":            \"FrontCamera\",  # Front camera (megapixels)\n",
        "    \"four_g\":        \"FourG\",        # Has 4G? (0 = no, 1 = yes)\n",
        "    \"int_memory\":    \"Storage\",      # Internal storage (GB)\n",
        "    \"m_dep\":         \"Thickness\",    # Phone thickness (cm)\n",
        "    \"mobile_wt\":     \"Weight\",       # Phone weight (grams)\n",
        "    \"n_cores\":       \"Cores\",        # Number of processor cores\n",
        "    \"pc\":            \"MainCamera\",   # Main (back) camera (megapixels)\n",
        "    \"px_height\":     \"PixelHeight\",  # Screen resolution height (pixels)\n",
        "    \"px_width\":      \"PixelWidth\",   # Screen resolution width (pixels)\n",
        "    \"ram\":           \"RAM\",          # RAM (MB)\n",
        "    \"sc_h\":          \"ScreenHeight\", # Screen height (cm)\n",
        "    \"sc_w\":          \"ScreenWidth\",  # Screen width (cm)\n",
        "    \"talk_time\":     \"TalkTime\",     # Hours of talk time on one full charge\n",
        "    \"three_g\":       \"ThreeG\",       # Has 3G? (0 = no, 1 = yes)\n",
        "    \"touch_screen\":  \"TouchScreen\",  # Has a touch screen? (0 = no, 1 = yes)\n",
        "    \"wifi\":          \"WiFi\",         # Has WiFi? (0 = no, 1 = yes)\n",
        "    \"price_range\":   \"PriceRange\",   # The label: 0 = low, 1 = medium, 2 = high, 3 = very high cost\n",
        "})\n",
        "\n",
        "label = \"PriceRange\"                                 # Name of the column we want to predict\n",
        "features = [c for c in data.columns if c != label]  # Every other column is a feature\n",
        "k = 4                                               # How many features the filter method will keep\n",
        "\n",
        "# 80% training / 20% testing; stratify keeps the same mix of classes in both parts\n",
        "train, test = train_test_split(data, test_size=0.2, stratify=data[label], random_state=42)\n",
        "\n",
        "scaler = StandardScaler()                                # Rescales each feature to mean 0 and spread 1\n",
        "X_train = pd.DataFrame(scaler.fit_transform(train[features]), columns=features, index=train.index)  # Learn the scale from TRAIN data only, then apply it\n",
        "X_test  = pd.DataFrame(scaler.transform(test[features]),      columns=features, index=test.index)   # Apply the same scale to the test data\n",
        "y_train, y_test = train[label], test[label]              # The answers (labels) for train and test\n",
        "\n",
        "print(\"Train:\", X_train.shape, \" Test:\", X_test.shape)   # (rows, columns) of each part\n",
        "print(\"Features:\", features)                             # List all feature names\n",
        "data.head()                                              # Show the first 5 rows of the renamed table"
      ]
